{% comment %}
  Section produit simple pour test
{% endcomment %}

<div class="product-page-simple">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        {% if product.images.size > 0 %}
          <img
            src="{{ product.featured_image | img_url: 'master' }}"
            alt="{{ product.title }}"
            class="img-fluid"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="col-md-6">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        <div class="description">{{ product.description }}</div>

        {% form 'product', product %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
          <button type="submit" class="btn btn-primary">Ajouter au panier</button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

<!-- filepath: sections/product-*.liquid -->
<script>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({
  event: "view_item",
  ecommerce: {
    items: [{
      item_id: "{{ product.selected_or_first_available_variant.id }}",
      item_name: "{{ product.title | escape }}",
      item_brand: "{{ product.vendor }}",
      item_category: "{{ product.type }}",
      price: {{ product.price | money_without_currency | replace: ',', '.' }},
      currency: "{{ shop.currency }}"
    }]
  }
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const btn = document.querySelector('[name="add"], .btn.btn-primary');
  if (!btn) return;

  btn.addEventListener("click", function() {
    window.dataLayer.push({
      event: "add_to_cart",
      ecommerce: {
        items: [{
          item_id: "{{ product.selected_or_first_available_variant.id }}",
          item_name: "{{ product.title | escape }}",
          price: {{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '.' }},
          quantity: 1
        }]
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Produit simple",
  "settings": [
    {
      "type": "header",
      "content": "Configuration"
    }
  ],
  "presets": [
    {
      "name": "Produit simple"
    }
  ]
}
{% endschema %}
